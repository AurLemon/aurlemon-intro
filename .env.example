#######################
#                     #
#        Site         #
#                     #
#######################

# Canonical public origin used by OAuth callbacks, verification emails,
# comment deep links, and generated site metadata. Do not add a trailing slash.
NUXT_SITE_URL=http://localhost:3000

# Optional client-side analytics identifiers.
NUXT_PUBLIC_BAIDU_STAT_KEY=
NUXT_PUBLIC_MS_CLARITY_ID=

#######################
#                     #
#      Database       #
#                     #
#######################

# Relative SQLite paths are resolved from the Prisma directory. This default
# therefore points to prisma/dev.db.
DATABASE_URL=file:./dev.db

#######################
#                     #
#   Authentication    #
#                     #
#######################

# Used only by the legacy-user migration and the first administrator bootstrap.
# Prefer immutable numeric GitHub user IDs; comma-separated values are allowed.
ADMIN_GITHUB_IDS=AurLemon

# GitHub OAuth. GITHUB_CALLBACK_URL is optional and otherwise derives from
# NUXT_SITE_URL as /api/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Linux DO Connect. LINUX_DO_CALLBACK_URL is optional and otherwise derives
# from NUXT_SITE_URL as /api/auth/linuxdo/callback.
LINUX_DO_CLIENT_ID=
LINUX_DO_CLIENT_SECRET=
LINUX_DO_CALLBACK_URL=

# Optional Linux DO endpoint overrides. Keep these defaults for the official
# Linux DO Connect service.
LINUX_DO_AUTHORIZE_URL=https://connect.linux.do/oauth2/authorize
LINUX_DO_TOKEN_URL=https://connect.linux.do/oauth2/token
LINUX_DO_USER_URL=https://connect.linux.do/api/user

#######################
#                     #
#        Mail         #
#                     #
#######################

# SMTP is disabled automatically while the host, credentials, or sender address
# are missing. Use port 465 with SMTP_SECURE=true or port 587 with false.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Sender identity used by verification and notification emails.
MAIL_FROM_NAME=AurLemon Intro
MAIL_FROM_ADDRESS=
MAIL_REPLY_TO=

#######################
#                     #
#   External Sources  #
#                     #
#######################

# Configure either GITHUB_TOKEN or the legacy GITHUB_PAT alias. The token is
# used for contribution data and migration preflight requests to the GitHub API.
GITHUB_TOKEN=
GITHUB_PAT=
GITHUB_CONTRIBUTIONS_USERNAME=AurLemon

# Bangumi profile whose public collections are displayed by the site.
BANGUMI_USERNAME=AurLemon

#######################
#                     #
#        Proxy        #
#                     #
#######################

# Optional Cloudflare Worker proxy for server-side provider requests. Enabling a
# provider requires both INTRO_PROXY_URL and INTRO_PROXY_HANDSHAKE_KEY.
GITHUB_PROXY_ENABLED=false
BANGUMI_PROXY_ENABLED=false
LINUX_DO_PROXY_ENABLED=false
INTRO_PROXY_URL=
INTRO_PROXY_HANDSHAKE_KEY=
